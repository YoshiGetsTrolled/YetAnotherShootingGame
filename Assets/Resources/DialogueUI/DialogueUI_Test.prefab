    name: What
    text: "TestTest\n\u30C6\u30B9\u30C8\n"
  - curSpeaker: 1
    iconLeft: {fileID: 21300000, guid: 80fc853fca1cd58458bf7c0a413adfec, type: 3}
    iconRight: {fileID: 21300000, guid: 81294d75ae24a5f4dbecf7dbbcf634bd, type: 3}
    name: Live
    text: "<color=red>\u8D64<color=blue>\u9752<color=green>\u7DD1<color=yellow>\u9EC4
      <color=black>\n<b>\u592A\u5B57\u3060\u3088</b> <i>\u659C\u4F53\u3060\u3088</i>
      <s>\u6253\u3061\u6D88\u3057\u7DDA</s> <u>\u4E0B\u7DDA</u>\n<size=150%>\u306A\u3001\u306A\u3093\u3060\u3063\u3066\u30FC\uFF01\uFF1F"
  - curSpeaker: 0
    iconLeft: {fileID: 21300000, guid: 80fc853fca1cd58458bf7c0a413adfec, type: 3}
    iconRight: {fileID: 21300000, guid: 81294d75ae24a5f4dbecf7dbbcf634bd, type: 3}
    name: What
    text: "\u6539\u884C\u6539\u884C\n<color=red>KAIGYOU\n<color=black>KAIGYOU"
  - curSpeaker: 1
    iconLeft: {fileID: 21300000, guid: 80fc853fca1cd58458bf7c0a413adfec, type: 3}
    iconRight: {fileID: 21300000, guid: 81294d75ae24a5f4dbecf7dbbcf634bd, type: 3}
    name: Live
